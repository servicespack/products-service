DATABASE_URI=mongodb://localhost:27017/products-service?replicaSet=rs0&directConnection=true

SERVER_PORT=3000

# Secret key used for signing and verifying JSON Web Tokens (JWT) for API and MCP authentication.
# MUST be the same secret used across the ecosystem for cross-service auth to work.
JWT_SECRET=

# The expected issuer for the JSON Web Tokens. Defaults to 'servicespack'.
JWT_ISSUER=servicespack

# The expected audience for the JSON Web Tokens. Defaults to 'servicespack'.
JWT_AUDIENCE=servicespack
