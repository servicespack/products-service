  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "knex": "npx knex --knexfile ./src/config/knexfile.ts",
    "lint": "eslint ./src",
    "lint:fix": "npm run lint -- --fix",
    "start": "node .",
    "start:dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
