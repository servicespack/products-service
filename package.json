{
  "name": "@servicespack/products-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "lint": "eslint ./src",
    "lint:fix": "npm run lint -- --fix",
    "start": "node .",
    "start:dev": "nodemon --exec 'ts-node -r dotenv/config src/index.ts | pino-pretty' --ext ts",
    "test": "vitest run",
    "test:cov": "npm test -- --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/servicespack/products-api.git"
  },
  "author": "Gabriel Rufino <contato@gabrielrufino.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/servicespack/products-api/issues"
  },
  "homepage": "https://github.com/servicespack/products-api#readme",
  "dependencies": {
    "@mikro-orm/core": "^6.4.11",
    "@mikro-orm/reflection": "^6.4.11",
    "@mikro-orm/sqlite": "^6.4.11",
    "express": "^4.21.2",
    "inversify": "^6.2.2",
    "neverthrow": "^8.2.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^9.6.0",
    "@types/express": "^5.0.1",
    "@types/supertest": "^6.0.3",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^16.4.7",
    "eslint": "^9.23.0",
    "eslint-config-turbo": "^2.4.4",
    "globals": "^15.15.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^2.1.8"
  }
}
