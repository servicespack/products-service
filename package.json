    "express": "^4.22.1",
    "inversify": "^6.2.2",
    "knex": "^3.1.0",
    "neverthrow": "^8.2.0",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^9.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.11",
